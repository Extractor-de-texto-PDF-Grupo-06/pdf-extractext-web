# Copiar a .env para correr el servicio fuera de Docker. En Docker las pasa el compose.

# ── Servicios de los que depende ──
DOCUMENTS_URL=http://localhost:8001
# En el sistema completo, el entrypoint interno de Traefik que balancea el extractor.
EXTRACTOR_URL=http://localhost:8080
CONFIG_URL=http://localhost:8003

# ── Respaldo de la configuración centralizada ──
# Rigen si config no responde o si la clave web/… no existe en Consul.
MAX_FILE_SIZE_MB=10
EXTRACTOR_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ── Clientes HTTP ──
CONFIG_CACHE_SECONDS=5
CONFIG_TIMEOUT_SECONDS=2
DOCUMENTS_TIMEOUT_SECONDS=10

# Puerto HTTP del servicio.
PORT=8000
